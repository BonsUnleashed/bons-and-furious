      ],
      "cancel": [],
      "conversion": "@ModifyReturnValue of Climate.ParameterList.codec(MapCodec): the returned codec is wrapped (ParameterListEncodes.Cached); decode unchanged; an encode of a list of at least 256 bound registry holders through RegistryOps over NbtOps into an empty prefix keeps the result as NBT bytes per ParameterList object (weak key) and returns a tag read from them while the list object, its element objects and the ops biome holder owner are unchanged",
      "license": "Minecraft (Mojang) no-copy: no Minecraft code is carried; the vanilla codec is called and its output kept as bytes (helper bons.furious.patch.vanilla_leveldat_encode.ParameterListEncodes)"
    }
