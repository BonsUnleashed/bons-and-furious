    "xaeroworldmap_upload_headroom": {
      "mod": "xaeroworldmap",
      "scripts": [],
      "since": "1.0.49",
      "kind": "change",
      "mixins": [
        "bons.furious.mixin.xaeroworldmap_c49.WmUploadHeadroomMixin"
      ],
      "guard": [
        {
          "class": "xaero/map/MapProcessor",
          "method": "onRenderProcess",
          "desc": "(Lnet/minecraft/client/Minecraft;)V",
          "note": "timeAvailable = max(3000000, totalTime - passed) (the only 3000000L), uploadUntil = uploadStart + timeAvailable / 4, uploads while nanoTime < uploadUntil; outside the map screen gpuLimit = max(1000000, min(totalTime / 5, timeAvailable))",
          "sha256": "037c723c86862a5961c66d57d71d486ef4ae0e14528f7b1b650a4b3d0c51e5e4"
        }
      ],
      "cancel": [],
      "conversion": "@ModifyConstant on the 3000000L of MapProcessor.onRenderProcess: the value (microseconds) while the world map screen is not open. Runtime flag xaeroworldmapUploadHeadroom. Helper bons.furious.patch.xaeroworldmap_c49.MapFramePacing.",
      "license": "All Rights Reserved (Xaero's World Map): none of its code is carried"
    },
