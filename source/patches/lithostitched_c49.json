{
  "group": "lithostitched_c49",
  "keys": {
    "lithostitched_template_shuffle_arrays": {
      "mod": "lithostitched",
      "scripts": [],
      "since": "1.0.49",
      "mixins": [
        "bons.furious.mixin.lithostitched_c49.TemplatesShuffleMixin",
        "bons.furious.mixin.lithostitched_c49.WeightedEntryAccessor"
      ],
      "guard": [
        {
          "class": "dev/worldgen/lithostitched/worldgen/structure/LithostitchedTemplates",
          "method": "shuffle",
          "desc": "(Lnet/minecraft/util/RandomSource;)Ljava/util/List;",
          "note": "Lithostitched 1.8.1: copies through a stream into an ArrayList, forEach one nextFloat per entry in index order, List.sort(comparingDouble(getRandWeight)) (stable), Stream.toList of the elements",
          "sha256": "1df6231360e3d808a9dcc11c318e0a1cf1a9b312a7e3bea9cdc45344ef6462af"
        },
        {
          "class": "dev/worldgen/lithostitched/worldgen/structure/LithostitchedTemplates",
          "method": "lambda$shuffle$0",
          "desc": "(Lnet/minecraft/util/RandomSource;Ldev/worldgen/lithostitched/worldgen/structure/LithostitchedTemplates$WeightedEntry;)V",
          "note": "entry.setRandom(random.nextFloat())",
          "sha256": "609590d47d1705105e69682a2cf6335b4fcb5c2ac9f353452e6448ee8bb5b7b3"
        },
        {
          "class": "dev/worldgen/lithostitched/worldgen/structure/LithostitchedTemplates",
          "method": "add",
          "desc": "(Lnet/minecraft/world/level/levelgen/structure/pools/StructurePoolElement;I)Ldev/worldgen/lithostitched/worldgen/structure/LithostitchedTemplates;",
          "note": "entries appended in order (index = the list size)",
          "sha256": "55db99107f968284ac9adad500982501fe6f8a4cff7f43b7a2a6c257900395ea"
        },
        {
          "class": "dev/worldgen/lithostitched/worldgen/structure/LithostitchedTemplates$WeightedEntry",
          "method": "<init>",
          "desc": "(Lnet/minecraft/world/level/levelgen/structure/pools/StructurePoolElement;II)V",
          "note": "element, index, weight; prioritized = element instanceof DelegatingPoolElement && prioritized()",
          "sha256": "dcb3df56105472899342777e0e63f8a0c525a4f0f68cd4d9f2c3c2a18d1d624e"
        },
        {
          "class": "dev/worldgen/lithostitched/worldgen/structure/LithostitchedTemplates$WeightedEntry",
          "method": "copy",
          "desc": "()Ldev/worldgen/lithostitched/worldgen/structure/LithostitchedTemplates$WeightedEntry;",
          "note": "new WeightedEntry(element, index, weight)",
          "sha256": "730eb52c40ae9700b7f94d984a84096a823c9e9b11c11a2371f495806988ef4c"
        },
        {
          "class": "dev/worldgen/lithostitched/worldgen/structure/LithostitchedTemplates$WeightedEntry",
          "method": "setRandom",
          "desc": "(F)V",
          "note": "-pow((double) value, (double) (1f / weight)) + (prioritized ? -2 : 0)",
          "sha256": "98ade6b3401e757796acaa2dc741d6086bccf2391248f4490146bc1227ab3095"
        },
        {
          "class": "dev/worldgen/lithostitched/worldgen/structure/LithostitchedTemplates$WeightedEntry",
          "method": "getRandWeight",
          "desc": "()D",
          "note": "field read",
          "sha256": "cc4082ca4aa9ccc7689e0da1cb71990e0dc70bac2dde6ac48f4878f315d637e7"
        },
        {
          "class": "dev/worldgen/lithostitched/worldgen/structure/LithostitchedTemplates$WeightedEntry",
          "method": "getElement",
          "desc": "()Lnet/minecraft/world/level/levelgen/structure/pools/StructurePoolElement;",
          "note": "field read",
          "sha256": "460fe9640fc5bb70c43e53cd8d14fda205279fd46d113ebc3769af848d89cb3e"
        },
        {
          "class": "dev/worldgen/lithostitched/worldgen/poolelement/DelegatingPoolElement",
          "method": "prioritized",
          "desc": "()Z",
          "note": "config.forcedCount().isPresent(): asked once per entry per shuffle, as the copy constructor does",
          "sha256": "e729e29f55135fff1015c76f499b4a3c3ce0f12df03596f133e68123303705bf"
        }
      ],
      "cancel": [],
      "conversion": "@Inject HEAD cancellable on LithostitchedTemplates.shuffle(RandomSource) answering from plain arrays (helper bons.furious.patch.lithostitched_c49.TemplateShuffle) + an @Accessor interface on LithostitchedTemplates$WeightedEntry (element, weight; the index field 1.8.1 added is not read by the shuffle)",
      "license": "MIT (Lithostitched): the shuffle is written from its formula; no Lithostitched code is carried"
    },
    "lithostitched_block_swap_table": {
      "mod": "lithostitched",
      "scripts": [],
      "since": "1.0.49",
      "mixins": [
        "bons.furious.mixin.lithostitched_c49.BlockSwapProcessorMixin"
      ],
      "guard": [
        {
          "class": "dev/worldgen/lithostitched/impl/worldgen/processor/BlockSwapStructureProcessor",
          "method": "processBlock",
          "desc": "(Lnet/minecraft/world/level/LevelReader;Lnet/minecraft/core/BlockPos;Lnet/minecraft/core/BlockPos;Lnet/minecraft/world/level/levelgen/structure/templatesystem/StructureTemplate$StructureBlockInfo;Lnet/minecraft/world/level/levelgen/structure/templatesystem/StructureTemplate$StructureBlockInfo;Lnet/minecraft/world/level/levelgen/structure/templatesystem/StructurePlaceSettings;)Lnet/minecraft/world/level/levelgen/structure/templatesystem/StructureTemplate$StructureBlockInfo;",
          "note": "Lithostitched 1.8.1 (moved to impl.worldgen.processor): registryAccess().lookupOrThrow(BLOCK); key = state.getBlock().builtInRegistryHolder().key(); containsKey(key) and the registry's get(map.get(key)) present -> new info(pos, target.withPropertiesOf(state), nbt); else the current info",
          "sha256": "ac7ab84c7c3b0b06120d120ba4dc9330a044c36fafa1fa63cff1c94af2dfdb84"
        },
        {
          "class": "dev/worldgen/lithostitched/impl/worldgen/processor/BlockSwapStructureProcessor",
          "method": "<init>",
          "desc": "(Ljava/util/Map;)V",
          "note": "the ResourceKey map field is final and set once",
          "sha256": "4a65eb234d471bbaeb6b8ff2e01d073ce5d68ed884b8c2855ed0e39371452f74"
        },
        {
          "class": "dev/worldgen/lithostitched/impl/worldgen/processor/BlockSwapStructureProcessor",
          "method": "*",
          "desc": "",
          "note": "declared methods: blockSwapMap is read only by processBlock and its getter",
          "sha256": "8a81bc1e1f7a6a5c7d8652a6e956505a674549daa034279039c97be10ee47da2"
        },
        {
          "class": "net/minecraft/core/Holder$Reference",
          "method": "key",
          "desc": "()Lnet/minecraft/resources/ResourceKey;",
          "note": "throws while the holder is unbound (Lithostitched's own path is kept for such a block)",
          "sha256": "9f5357ecd23795e12ec2eee6746a6f945fad6dda53efcf72200d70f897237d77"
        },
        {
          "class": "net/minecraft/core/Holder$Reference",
          "method": "isBound",
          "desc": "()Z",
          "note": "key != null && value != null",
          "sha256": "4366a57b41341ec1583b1b2df5a1cbf7a74c5ad5aa4cfe2c8dcd0dd3fc16e2fc"
        },
        {
          "class": "net/minecraft/core/MappedRegistry",
          "method": "getHolder",
          "desc": "(Lnet/minecraft/resources/ResourceKey;)Ljava/util/Optional;",
          "note": "byKey.get(resolve(key)): the registry lookup's get, NeoForge aliases resolved",
          "sha256": "6b686926767ffdd78eb0930124e057da3f5e007964de667c2711cac91e7236ff"
        },
        {
          "class": "net/minecraft/core/MappedRegistry",
          "method": "containsKey",
          "desc": "(Lnet/minecraft/resources/ResourceKey;)Z",
          "note": "byKey.containsKey(key): no alias followed",
          "sha256": "84f49350cbfaf0db5ef7e9381fbf011babd2d30898a4638c689c4e9a3943ad90"
        },
        {
          "class": "net/minecraft/server/level/WorldGenRegion",
          "method": "registryAccess",
          "desc": "()Lnet/minecraft/core/RegistryAccess;",
          "note": "the server level's registry access",
          "sha256": "8c9619c15c809baa281d5de6ee3c569e5cc3204624e5b883723405984edeca6e"
        },
        {
          "class": "net/minecraft/world/level/Level",
          "method": "registryAccess",
          "desc": "()Lnet/minecraft/core/RegistryAccess;",
          "note": "the field set from the server's composite registry access",
          "sha256": "b64f3b4c47ea27cac2f0cb9122bfca9f1ffbb63f75921ec19c6a3d40166215ee"
        }
      ],
      "cancel": [],
      "conversion": "@Inject HEAD cancellable on BlockSwapStructureProcessor.processBlock answering, for a ServerLevel or WorldGenRegion, from a per-processor identity table Block -> Block (helper bons.furious.patch.lithostitched_c49.SwapTable, a volatile @Unique field); a table miss answers the current info only for a block with a bound registry holder; shadow: @Inject RETURN compares. Lithostitched 1.8.1 keys its map by ResourceKey<Block>, reads the block registry from the level and leaves a block alone when the target key names no block (1.4.11 resolved it to air), so the table takes only resolvable targets and is used only for the server's registries.",
      "license": "MIT (Lithostitched): no Lithostitched code is carried; Minecraft (Mojang): no-copy"
    }
  }
}
