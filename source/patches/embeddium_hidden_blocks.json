{
  "group": "embeddium_hidden_blocks",
  "keys": {
    "embeddium_hidden_block_skip": {
      "mod": "embeddium",
      "scripts": [],
      "since": "1.0.50",
      "mixins": [
        "bons.furious.mixin.embeddium_hidden_blocks.BlockRendererOcclusionAccessor",
        "bons.furious.mixin.embeddium_hidden_blocks.BlockRendererRegistryAccessor",
        "bons.furious.mixin.embeddium_hidden_blocks.MeshingTaskHiddenBlockMixin",
        "bons.furious.mixin.embeddium_hidden_blocks.SimpleBakedModelCulledOnlyMixin",
        "bons.furious.mixin.embeddium_hidden_blocks.WeightedBakedModelCulledOnlyMixin"
      ],
      "guard": [
        {
          "class": "org/embeddedt/embeddium/impl/render/chunk/compile/tasks/ChunkBuilderMeshingTask",
          "method": "execute",
          "desc": "(Lorg/embeddedt/embeddium/impl/render/chunk/compile/ChunkBuildContext;Lorg/embeddedt/embeddium/impl/util/task/CancellationToken;)Lorg/embeddedt/embeddium/impl/render/chunk/compile/ChunkBuildOutput;",
          "note": "per block: air without a block entity is skipped; render shape MODEL -> model data (from the world slice), seed, unwrap, one renderModel per render layer; then the fluid, the block entity and the occlusion graph, none of which read the model branch",
          "sha256": "f866bcd437c4c7dc39270ebd8bdac1a39268fcddac3a914be0da930b65d9d08b"
        },
        {
          "class": "org/embeddedt/embeddium/impl/render/chunk/compile/pipeline/BlockRenderer",
          "method": "renderModel",
          "desc": "(Lorg/embeddedt/embeddium/api/render/chunk/BlockRenderContext;Lorg/embeddedt/embeddium/impl/render/chunk/compile/ChunkBuildBuffers;)V",
          "note": "custom renderers first, FRAPI models through the Indigo handler; else per side: the side's quads are written only when isFaceVisible; then the quads of the null side, always",
          "sha256": "e99ce1590f8e8c31526f0cb5720cb5d2ef22fee652b550e4302d6a5e7b3b6158"
        },
        {
          "class": "org/embeddedt/embeddium/impl/render/chunk/compile/pipeline/BlockRenderer",
          "method": "isFaceVisible",
          "desc": "(Lorg/embeddedt/embeddium/api/render/chunk/BlockRenderContext;Lnet/minecraft/core/Direction;)Z",
          "note": "occlusionCache.shouldDrawSide(ctx.state(), ctx.localSlice(), ctx.pos(), face)",
          "sha256": "dc105d355cda9bfa2ae0b8f78db8ac65c1647bde037142e83c81682e16885a07"
        },
        {
          "class": "org/embeddedt/embeddium/impl/render/chunk/compile/pipeline/BlockOcclusionCache",
          "method": "shouldDrawSide",
          "desc": "(Lnet/minecraft/world/level/block/state/BlockState;Lnet/minecraft/world/level/BlockGetter;Lnet/minecraft/core/BlockPos;Lnet/minecraft/core/Direction;)Z",
          "note": "reads the neighbour's state and the two face occlusion shapes; its own cache is its only state",
          "sha256": "82c9100041af063867b93cc1d459d205f02e31d91fed1e509320ad91d85b9dd7"
        },
        {
          "class": "net/minecraft/client/resources/model/SimpleBakedModel",
          "method": "getQuads",
          "desc": "(Lnet/minecraft/world/level/block/state/BlockState;Lnet/minecraft/core/Direction;Lnet/minecraft/util/RandomSource;)Ljava/util/List;",
          "note": "getQuads: side == null ? unculledFaces : culledFaces.get(side)",
          "sha256": "d0cb29735c0d26a7f3442f15f920697f95d072673578e17c3ba2eaa8d1d96031"
        },
        {
          "class": "org/embeddedt/embeddium/impl/render/chunk/compile/pipeline/BlockRenderer",
          "method": "getGeometry",
          "desc": "(Lorg/embeddedt/embeddium/api/render/chunk/BlockRenderContext;Lnet/minecraft/core/Direction;)Ljava/util/List;",
          "note": "re-seeds the renderer's random source with the block seed before every model call",
          "sha256": "33a4fc93f6b4c2c96fdc503937bc0cf845c749ba9ecb6ae36810e8d0e5747b64"
        },
        {
          "class": "org/embeddedt/embeddium/api/BlockRendererRegistry",
          "method": "fillCustomRenderers",
          "desc": "(Ljava/util/List;Lorg/embeddedt/embeddium/api/render/chunk/BlockRenderContext;)V",
