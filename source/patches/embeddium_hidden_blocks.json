          "sha256": "8f46a07539e7ea2adf895e55a88af51a621a850b081a03ca45093ce5954e471f"
        },
        {
          "class": "org/embeddedt/embeddium/impl/render/frapi/IndigoBlockRenderContext",
          "method": "renderEmbeddium",
