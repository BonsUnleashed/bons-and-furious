{
  "group": "attribute_lookup",
  "keys": {
    "vanilla_attribute_instance_fast_lookup": {
      "mod": "minecraft",
      "scripts": [],
      "since": "1.0.49",
      "mixins": [
        "bons.furious.mixin.attribute_lookup.AttributeMapFastLookupMixin"
      ],
      "cancel": [],
      "conversion": "injectors: MixinExtras @WrapMethod on AttributeMap.m_22146_ (getInstance) answering a held instance from the map and an attribute the supplier lacks with null, else the original (helper bons.furious.patch.attribute_lookup.AttributeLookup; the ATTRIBUTE_REAPPLY API AttributeReapply lives in this group)",
      "license": "Minecraft: no code is carried, the wrapper only reads the map and the supplier",
      "guard": [
        {
          "class": "net/minecraft/world/entity/ai/attributes/AttributeMap",
          "method": "m_22146_",
          "desc": "(Lnet/minecraft/world/entity/ai/attributes/Attribute;)Lnet/minecraft/world/entity/ai/attributes/AttributeInstance;",
          "note": "attributes.computeIfAbsent(attribute, a -> supplier.createInstance(this::onAttributeModified, a))",
          "sha256": "19b9318b1c17b68d602cee0a772f66ed03324aa80d20b973633ec28652ff29bd"
        },
        {
          "class": "net/minecraft/world/entity/ai/attributes/AttributeMap",
          "method": "m_22187_",
          "desc": "(Lnet/minecraft/world/entity/ai/attributes/Attribute;)Lnet/minecraft/world/entity/ai/attributes/AttributeInstance;",
          "note": "the lambda: supplier.createInstance(this::onAttributeModified, a)",
          "sha256": "8b16cfe451a546e395f7fabb3192004e42e1518e116c9e70a8173b3ef9926f39"
        },
        {
          "class": "net/minecraft/world/entity/ai/attributes/AttributeSupplier",
          "method": "m_22250_",
          "desc": "(Ljava/util/function/Consumer;Lnet/minecraft/world/entity/ai/attributes/Attribute;)Lnet/minecraft/world/entity/ai/attributes/AttributeInstance;",
          "note": "createInstance: instances.get(attribute) == null -> null, else a new instance copied from it",
          "sha256": "435f04c3ef6c51abff0bb09594bcb4ffabf4effb8a0a1e9834f04f2227f78f67"
        },
        {
          "class": "net/minecraft/world/entity/ai/attributes/AttributeSupplier",
          "method": "m_22258_",
          "desc": "(Lnet/minecraft/world/entity/ai/attributes/Attribute;)Z",
          "note": "hasAttribute: instances.containsKey(attribute)",
          "sha256": "8ec381cde1ed841540adb7f58be02c52aa98f2abb2ab06f73a8bce21e9f2d6cc"
        }
      ]
    },
    "projectiledamage_weapon_modifier_unchanged_skip": {
      "mod": "projectile_damage",
      "scripts": [],
      "since": "1.0.49",
      "kind": "variant",
      "mixins": [
        "bons.furious.mixin.attribute_lookup.ProjectileDamageReapplyMixin",
        "bons.furious.mixin.attribute_lookup.AttributeMapReapplyAccessor"
      ],
      "cancel": [],
      "conversion": "injectors: a MixinSquared @TargetHandler @WrapOperation of the AttributeMap.addTransientAttributeModifiers call in Projectile Damage's ServerWorldMixin.pre_spawnEntity handler (merged into ServerLevel.addFreshEntity), skipped when every weapon modifier is already held unchanged and transient; an @Accessor for AttributeMap's instance map and supplier (helpers bons.furious.patch.attribute_lookup.ProjectileReapply, AttributeReapply)",
      "license": "Projectile Damage (GPL-3.0): no Projectile Damage code is carried, the injection only wraps one call with our own check",
      "guard": [
        {
          "class": "net/projectile_damage/mixin/ServerWorldMixin",
          "method": "pre_spawnEntity",
          "desc": "(Lnet/minecraft/world/entity/Entity;Lorg/spongepowered/asm/mixin/injection/callback/CallbackInfoReturnable;)V",
          "note": "arrow with a living owner and a ranged weapon: owner.getAttributes().addTransientAttributeModifiers(weapon.getAttributeModifiers(slot)), then reads GENERIC_PROJECTILE_DAMAGE",
          "sha256": "9d103a43ac6302fb6239f0530aff11d00f9d502b03e62d8abedf5d64fc7fbbc7"
        },
        {
          "class": "net/minecraft/world/entity/ai/attributes/AttributeMap",
