          "desc": "(Lcom/google/common/collect/Multimap;)V",
          "note": "addTransientAttributeModifiers: per entry getInstance; when not null removeModifier(modifier) + addTransientModifier(modifier)",
          "sha256": "c37d5a21a48e6cbfe09d9f13f90a7e2fdd6a1a0e3372ab47a0c584640a75b7b4"
        },
        {
          "class": "net/minecraft/world/entity/ai/attributes/AttributeInstance",
          "method": "m_22118_",
          "desc": "(Lnet/minecraft/world/entity/ai/attributes/AttributeModifier;)V",
          "note": "addTransientModifier = addModifier",
          "sha256": "2a8a80759bde722846a1e3e820ad49523a423adf85ab210c25298a9259e7eeb7"
        },
        {
          "class": "net/minecraft/world/entity/ai/attributes/AttributeInstance",
          "method": "m_22111_",
          "desc": "(Ljava/util/UUID;)Lnet/minecraft/world/entity/ai/attributes/AttributeModifier;",
          "note": "getModifier: modifierById.get(uuid)",
          "sha256": "7a9e9d9c7855dd3f342c69a5deea906a408d045960683bb81281e5813a135607"
        },
