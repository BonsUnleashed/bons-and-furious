          "desc": "(Lnet/minecraft/world/entity/ai/attributes/AttributeModifier;)V",
          "note": "removeModifier: operation set, id map and permanent set remove (by UUID), then setDirty",
          "sha256": "1a36bba283103cf86bf1f38843281b2ddab1793edce903a3d2947560718afcdd"
        },
        {
          "class": "net/minecraft/world/entity/ai/attributes/AttributeInstance",
          "method": "m_22133_",
          "desc": "(Lnet/minecraft/world/entity/ai/attributes/AttributeModifier;)V",
          "note": "addModifier: putIfAbsent by UUID (throws when present), operation set add, setDirty",
          "sha256": "a04c6fff95e4fd1f662cffb1e88ba8919562222fe7c5dc816224eb60235f900a"
        },
        {
          "class": "net/minecraft/world/entity/ai/attributes/AttributeModifier",
          "method": "equals",
          "desc": "(Ljava/lang/Object;)Z",
          "note": "equal by UUID",
          "sha256": "a8f7833c5e55e2b47869ff3d89996883f9be66a35890c372de00a920a90f6f0a"
        },
        {
          "class": "net/minecraft/world/entity/ai/attributes/AttributeModifier",
